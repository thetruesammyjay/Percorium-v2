APP_ENV=development
APP_NAME=Percorium API
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=sqlite+aiosqlite:///./percorium.db
REDIS_URL=

# Solana reads
ALCHEMY_SOLANA_RPC_URL=
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGgkZwyTDt1v
SOLANA_WRAPPED_SOL_MINT=So11111111111111111111111111111111111111112
SOLANA_USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
SOLANA_TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# Official asset allowlists. Keep stock and ETF mints operator-reviewed;
# Jupiter enriches those mints with metadata and remains the execution engine.
JUPITER_STOCK_MINTS=
JUPITER_ETF_MINTS=
# Optional operator registry CSV. Relative paths resolve from apps/api.
ASSET_REGISTRY_FILE=../../sunrise_stocks_etfs_prestocks.csv
PREIPO_API_URL=https://prestocks.com/api/prestocks
# Comma-separated reviewed PreStocks mints. Empty means no Pre-IPO trading.
PREIPO_PINNED_MINTS=
# Operator-owned JSON list of indexed/featured memestocks (never client input).
NEW_LAUNCHES_FILE=
ALLOWLIST_CACHE_SECONDS=900

# Jupiter execution
JUPITER_API_KEY=
JUPITER_API_URL=https://api.jup.ag
JUPITER_TOKENS_PATH=/tokens/v2/search
JUPITER_PRICE_PATH=/price/v3
JUPITER_QUOTE_PATH=/swap/v1/quote
JUPITER_SWAP_PATH=/swap/v1/swap
JUPITER_TRIGGER_CREATE_PATH=/trigger/v2/createOrder

# Identity and market data
FINNHUB_API_KEY=
FINNHUB_API_URL=https://finnhub.io/api/v1
MARKET_FEED_SYMBOLS=SPY,QQQ,DIA,IWM,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AVGO,BRK.B,JPM,V,UNH,LLY,XOM,AMD,NFLX,COST,ORCL,PLTR
CRYPTO_FEED_MINTS=So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGgZwyTDt1v,JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN
PRIVY_APP_ID=
PRIVY_APP_SECRET=
SNS_RESOLVER_URL=

# Product
PERCORIUM_FEE_BPS=50
# Must be an initialized Jupiter fee token account for the selected swap mint.
PLATFORM_FEE_WALLET=
BASE_ENABLED=false
MAGICBLOCK_ENABLED=false
QUOTE_TTL_SECONDS=30

# Runtime
DB_AUTO_CREATE=true
AUTH_REQUIRED=false
LOG_LEVEL=INFO
DOCS_ENABLED=true
HTTP_TIMEOUT_SECONDS=10
HTTP_TRUST_ENV=false
