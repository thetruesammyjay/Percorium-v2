APP_ENV=development
APP_NAME=Percorium API
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite+aiosqlite:///./percorium.db
REDIS_URL=

# Solana reads
ALCHEMY_SOLANA_RPC_URL=
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGgkZwyTDt1v
SOLANA_WRAPPED_SOL_MINT=So11111111111111111111111111111111111111112
SOLANA_USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
SOLANA_TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# Official asset allowlists. Sunrise is used only as the Stocks source;
# Jupiter remains the quote/swap/order execution engine.
SUNRISE_API_URL=
SUNRISE_API_KEY=
SUNRISE_LIST_TOKENS_PATH=/list-tokens
PREIPO_API_URL=https://prestocks.com/api/prestocks
ALLOWLIST_CACHE_SECONDS=900

# Jupiter execution
JUPITER_API_KEY=
JUPITER_API_URL=https://api.jup.ag
JUPITER_QUOTE_PATH=/swap/v1/quote
JUPITER_SWAP_PATH=/swap/v1/swap
JUPITER_TRIGGER_CREATE_PATH=/trigger/v2/createOrder

# Identity and market data
FINNHUB_API_KEY=
FINNHUB_API_URL=https://finnhub.io/api/v1
MARKET_FEED_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMZN
PRIVY_APP_ID=
PRIVY_APP_SECRET=
SNS_RESOLVER_URL=

# Product
PERCORIUM_FEE_BPS=50
# Must be an initialized Jupiter fee token account for the selected swap mint.
PLATFORM_FEE_WALLET=
BASE_ENABLED=false
MAGICBLOCK_ENABLED=false
QUOTE_TTL_SECONDS=30

# Runtime
DB_AUTO_CREATE=true
AUTH_REQUIRED=false
LOG_LEVEL=INFO
DOCS_ENABLED=true
HTTP_TIMEOUT_SECONDS=10